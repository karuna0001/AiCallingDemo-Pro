+    wb = Workbook()
+    ws = wb.active
+    ws.title = "CRM Leads"
+    ws.append(CRM_EXPORT_COLUMNS)
+    for cell in ws[1]:
+        cell.font = Font(bold=True)
+    for row in rows:
