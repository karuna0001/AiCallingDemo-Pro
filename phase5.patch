+def _normalize_upload_row(row: dict) -> dict:
+    aliases = {"phone": "phone_number", "name": "lead_name"}
+    out = {}
+    for key, value in row.items():
+        clean_key = (key or "").strip().lower()
+        out[aliases.get(clean_key, clean_key)] = value
+    return out
