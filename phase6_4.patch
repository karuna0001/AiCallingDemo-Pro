 async function loadInboundHealth(){try{const h=await api('/api/inbound/health');$('inbound-error').textContent='';const badge=(label,ok,good='configured',bad='missing')=>`<span class="badge ${ok?'ok':'err'}">${label}: ${ok?good:bad}</span>`;$('inbound-health').innerHTML=[badge('Inbound Enabled',h.inbound_enabled,'ON','OFF'),badge('Inbound Trunk',h.inbound_trunk_configured),badge('Dispatch Rule',h.inbound_dispatch_rule_configured),badge('Inbound Phone Number',h.inbound_phone_number_configured),badge('Inbound Agent Profile',h.inbound_agent_profile_configured),badge('Business Name',h.inbound_business_name_configured),badge('Transfer Number',h.default_transfer_number_configured)].join('')}catch(e){$('inbound-error').textContent='Unable to load inbound data.'}}
 async function loadInboundStats(){try{const s=await api('/api/inbound/stats');$('inbound-stats').innerHTML=[['Total Inbound Calls',s.total_inbound_calls],['Booked Inbound',s.booked_inbound],['Callback Requested',s.callback_requested],['Transferred',s.transferred],['FAQ Only',s.faq_only],['Average Duration',(s.average_duration_seconds||0)+'s']].map(x=>`<div class="card"><div>${x[0]}</div><div class="kpi">${x[1]||0}</div></div>`).join('')}catch(e){$('inbound-error').textContent='Unable to load inbound data.'}}
 async function loadInboundSettings(){try{const s=await api('/api/inbound/settings');inboundKeys.forEach(k=>{const el=$('in-'+k);if(el)el.value=s[k]||((k==='INBOUND_ENABLED'||k==='INBOUND_AFTER_HOURS_MODE')?'false':'')})}catch(e){$('inbound-error').textContent='Unable to load inbound data.'}}
